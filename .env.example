# Bun automatically loads .env. Never put secrets in NUXT_PUBLIC_* variables.
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Regional endpoint, without the bucket name. Use HTTPS in production.
OBS_ENDPOINT=https://obs.cn-east-3.myhuaweicloud.com
OBS_BUCKET=
OBS_REGION=cn-east-3
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
# Optional temporary IAM credential
OBS_SECURITY_TOKEN=
OBS_PREFIX=classroom

CLASS_NAME=我们的班级
DATA_DIR=.data
UPLOAD_MAX_MB=50
NITRO_BUN_IDLE_TIMEOUT=240
# Prepared downloads expire after 60 minutes; allowed range: 1–1440.
DOWNLOAD_TTL_MINUTES=60
# HTTPS deployment: set to true. Local HTTP preview: false.
COOKIE_SECURE=false
# Optional public address for shared links, e.g. https://homework.example.com
APP_URL=
# Behind exactly one trusted reverse proxy, set true for per-IP rate limiting.
TRUST_PROXY=false

# Docker + Caddy deployment only; DOMAIN is a hostname, without https://.
DOMAIN=homework.example.com
ACME_EMAIL=admin@example.com

# No-domain HTTP deployment: uncomment COMPOSE_FILE and set APP_URL=http://YOUR_PUBLIC_IP.
# COMPOSE_FILE=compose.http.yaml
# HTTP_PORT=80
