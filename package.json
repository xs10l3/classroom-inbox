{
  "name": "classroom-inbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun node_modules/nuxt/bin/nuxt.mjs dev --host 0.0.0.0",
    "build": "bun --bun node_modules/nuxt/bin/nuxt.mjs build",
    "start": "bun .output/server/index.mjs",
    "postinstall": "bun --bun node_modules/nuxt/bin/nuxt.mjs prepare",
    "typecheck": "bun --bun node_modules/nuxt/bin/nuxt.mjs typecheck",
    "format": "prettier --write app server shared tests scripts nuxt.config.ts package.json",
    "backup": "bun scripts/backup.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun tests/integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1072.0",
    "archiver": "^7.0.1",
    "exceljs": "^4.4.0",
    "h3": "^1.15.4",
    "lucide-vue-next": "^0.468.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "jszip": "^3.10.2",
    "@types/archiver": "^6.0.3",
    "@types/bun": "^1.3.0",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "bun": ">=1.3.8"
  },
  "packageManager": "bun@1.3.8"
}
